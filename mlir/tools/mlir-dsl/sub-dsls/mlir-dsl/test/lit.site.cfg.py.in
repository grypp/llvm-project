@LIT_SITE_CFG_IN_HEADER@

import sys

config.llvm_tools_dir = lit_config.substitute(path(r"@LLVM_TOOLS_DIR@"))
config.llvm_shlib_ext = "@SHLIBEXT@"
config.mlir_obj_root = path(r"@MLIR_BINARY_DIR@")
config.mlir_dsl_src_root = path(r"@CMAKE_CURRENT_SOURCE_DIR@")
config.mlir_dsl_obj_root = path(r"@CMAKE_CURRENT_BINARY_DIR@")
config.python_executable = "@Python3_EXECUTABLE@"
config.enable_bindings_python = @MLIR_ENABLE_BINDINGS_PYTHON@
config.enable_execution_engine = @MLIR_ENABLE_EXECUTION_ENGINE@

import lit.llvm
lit.llvm.initialize(lit_config, config)

# Let the main config do the real work.
lit_config.load_config(config, path(r"@CMAKE_CURRENT_SOURCE_DIR@/lit.cfg.py"))
